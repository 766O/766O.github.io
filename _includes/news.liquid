<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% assign preview_limit = 5 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: preview_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_size > preview_limit %}
      <div id="news-more" style="display: none;">
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in news offset: preview_limit %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </div>
      <div style="text-align: center; margin-top: 0.1rem; margin-bottom: 1.5rem;">
        <a href="#" id="news-toggle-btn" onclick="toggleNews(); return false;"
           style="font-size: 0.8rem; color: var(--global-text-color-light); text-decoration: none;">
          show more <i id="news-toggle-icon" class="fa-solid fa-angle-down" style="font-size: 0.75rem;"></i>
        </a>
      </div>
      <script>
        function toggleNews() {
          var moreDiv = document.getElementById('news-more');
          var btn = document.getElementById('news-toggle-btn');
          var icon = document.getElementById('news-toggle-icon');
          if (moreDiv.style.display === 'none') {
            moreDiv.style.display = 'block';
            btn.childNodes[0].nodeValue = 'show less ';
            icon.className = 'fa-solid fa-angle-up';
          } else {
            moreDiv.style.display = 'none';
            btn.childNodes[0].nodeValue = 'show more ';
            icon.className = 'fa-solid fa-angle-down';
          }
        }
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
