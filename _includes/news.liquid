<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% assign preview_limit = 5 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: preview_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_size > preview_limit %}
      <div id="news-more" style="display: none;">
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in news offset: preview_limit %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </div>
      <button id="news-toggle-btn" onclick="toggleNews()" class="btn btn-sm btn-outline-secondary mt-1">
        show more
      </button>
      <script>
        function toggleNews() {
          var moreDiv = document.getElementById('news-more');
          var btn = document.getElementById('news-toggle-btn');
          if (moreDiv.style.display === 'none') {
            moreDiv.style.display = 'block';
            btn.textContent = 'show less';
          } else {
            moreDiv.style.display = 'none';
            btn.textContent = 'show more';
          }
        }
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
